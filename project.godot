; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="volleyball"
run/main_scene="res://game/ui/boot/gpu_notice.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(1, 0.84, 0.24, 1)
boot_splash/show_image=false
config/icon="uid://ewerp6c0ycjk"

[autoload]

GameConfig="*res://game/core/game_config.gd"
ProfileStore="*res://game/core/profile_store.gd"
SupabaseClient="*res://game/core/supabase_client.gd"
LocalPlayers="*res://game/core/local_players.gd"
InputPrompts="*res://game/core/input_prompts.gd"
MusicManager="*res://game/audio/music_manager.tscn"
Career="*res://game/core/career.gd"
Net="*res://game/net/net.gd"
OnlineTerms="*res://game/net/online_terms.gd"
Achievements="*res://game/core/achievements.gd"
PerfOverlay="*res://game/ui/perf_overlay.gd"
InputBinds="*res://game/core/input_binds.gd"
CursorTrail="*res://game/ui/cursor_trail.gd"
TouchControls="*res://game/ui/touch/touch_controls.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale=1.4
window/vsync/vsync_mode=0
window/handheld/orientation=4

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[editor_plugins]

enabled=PackedStringArray("res://addons/GPUTrail-main/plugin.cfg")

[gui]

theme/custom="res://game/ui/game_theme.tres"

